# =====================================================================
# LAB 02 - Bitcoin Scripting Language (Bitcoin Testnet Configuration)
# Copy file này thành `.env` khi chạy thực tế trên máy cá nhân.
# KHÔNG commit file `.env` chứa Private Key thực lên Git!
# =====================================================================

# Mạng Bitcoin: testnet (mặc định cho Lab 02, hỗ trợ Testnet3/Testnet4 REST API)
BITCOIN_NETWORK=testnet

# REST API Provider để truy vấn UTXO, lấy thông tin giao dịch và broadcast raw tx
# Mặc định dùng Mempool.space Testnet API (có fallback sang Blockstream Testnet API)
TESTNET_API_BASE_URL=https://mempool.space/testnet/api
TESTNET_API_FALLBACK_URL=https://blockstream.info/testnet/api

# Cấu hình mạng & Phí giao dịch mặc định
HTTP_TIMEOUT_SECONDS=15
DEFAULT_FEE_RATE_SAT_VB=2
DUST_THRESHOLD_SATOSHIS=546

# Chế độ chạy mặc định cho CLI (true = dùng Mock/Stub nội bộ, false = gọi Testnet thật)
USE_MOCK_SERVICES=false
